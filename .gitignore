# Android 原生构建输出与临时缓存
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/app/*.iml

# 确保 CI 构建所需的 Gradle 包装器和可执行脚本被正常追踪
!android/gradle/wrapper/gradle-wrapper.jar
!android/gradle/wrapper/gradle-wrapper.properties
!android/gradlew
!android/gradlew.bat
